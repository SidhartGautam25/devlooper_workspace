datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

enum Role {
  SUPERUSER
  EMPLOYEE
  USER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum LeadStatus {
  NEW
  CONTACTED
  IN_DISCUSSION
  QUALIFIED
  CONVERTED
  LOST
}

model User {
  id            String   @id @default(uuid())
  employeeId    String?  @unique @default(uuid())
  name          String
  email         String   @unique
  passwordHash  String
  role          Role     @default(EMPLOYEE)
  phone         String?
  isActive      Boolean  @default(true)

  languageId    String?
  language      Language? @relation(fields: [languageId], references: [id], onDelete: SetNull)

  regionId      String?
  region        Region?   @relation(fields: [regionId], references: [id], onDelete: SetNull)

  employeeRoleId String?
  employeeRole   EmployeeRole? @relation(fields: [employeeRoleId], references: [id], onDelete: SetNull)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdTasks  Task[] @relation("CreatedTasks")
  assignedTasks Task[] @relation("AssignedTasks")
  assignedLeads Lead[] @relation("AssignedLeads")
  taskGroups    TaskGroup[]

  @@index([role])
  @@index([email])
  @@index([employeeId])
  @@index([languageId])
  @@index([regionId])
  @@index([employeeRoleId])
}

enum TaskResult {
  PASS
  FAIL
}

model BusinessType {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks      Task[]
  taskGroups TaskGroup[]
}

model Language {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks      Task[]
  employees  User[]
  taskGroups TaskGroup[]
}

model Region {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks      Task[]
  employees  User[]
  taskGroups TaskGroup[]
}

model EmployeeRole {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees User[]
}

model TaskGroup {
  id             String        @id @default(uuid())
  name           String        @unique
  description    String?       @db.Text
  priority       TaskPriority? @default(MEDIUM)

  businessName   String?
  businessTypeId String?
  businessType   BusinessType? @relation(fields: [businessTypeId], references: [id], onDelete: SetNull)

  languageId     String?
  language       Language?     @relation(fields: [languageId], references: [id], onDelete: SetNull)

  regionId       String?
  region         Region?       @relation(fields: [regionId], references: [id], onDelete: SetNull)

  assignedToId   String?
  assignedTo     User?         @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  tasks          Task[]

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([businessTypeId])
  @@index([languageId])
  @@index([regionId])
  @@index([assignedToId])
}

model Task {
  id          String       @id @default(uuid())
  title       String
  description String?      @db.Text
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?

  taskGroupId    String?
  taskGroup      TaskGroup?    @relation(fields: [taskGroupId], references: [id], onDelete: SetNull)

  businessName   String?
  businessTypeId String?
  businessType   BusinessType? @relation(fields: [businessTypeId], references: [id], onDelete: SetNull)

  languageId     String?
  language       Language?     @relation(fields: [languageId], references: [id], onDelete: SetNull)

  regionId       String?
  region         Region?       @relation(fields: [regionId], references: [id], onDelete: SetNull)

  contactDetail  String?       @db.Text
  contactPhone   String?
  contactEmail   String?

  callDuration String?
  callDetail   String?     @db.Text
  result       TaskResult?

  createdById String
  createdBy   User   @relation("CreatedTasks", fields: [createdById], references: [id], onDelete: Cascade)

  assignedToId String?
  assignedTo   User?   @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assignedToId])
  @@index([status])
  @@index([taskGroupId])
  @@index([businessTypeId])
  @@index([languageId])
  @@index([regionId])
}

model Lead {
  id     String  @id @default(cuid())
  name   String
  email  String?
  phone  String?
  company String?

  packageId   String?
  packageName String?
  category    String?
  priceInr    Int?

  projectDetails  String? @db.Text
  sourceUrl       String?
  sourceComponent String?

  source  String?
  service String?
  budget  String?

  status        LeadStatus @default(NEW)
  notes         String?    @db.Text
  internalNotes String?    @db.Text

  assignedToId String?
  assignedTo   User?   @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assignedToId])
  @@index([status])
  @@index([createdAt])
  @@index([packageId])
}
