datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

enum Role {
  SUPERUSER
  EMPLOYEE
  USER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum LeadStatus {
  NEW
  CONTACTED
  IN_DISCUSSION
  QUALIFIED
  CONVERTED
  LOST
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  passwordHash  String
  role          Role     @default(EMPLOYEE)
  phone         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdTasks  Task[] @relation("CreatedTasks")
  assignedTasks Task[] @relation("AssignedTasks")
  assignedLeads Lead[] @relation("AssignedLeads")

  @@index([role])
  @@index([email])
}

enum TaskResult {
  PASS
  FAIL
}

model BusinessType {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks Task[]
}

model Task {
  id          String       @id @default(uuid())
  title       String
  description String?      @db.Text
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?

  businessName   String?
  businessTypeId String?
  businessType   BusinessType? @relation(fields: [businessTypeId], references: [id], onDelete: SetNull)
  contactDetail  String?       @db.Text
  contactPhone   String?
  contactEmail   String?

  callDuration String?
  callDetail   String?     @db.Text
  result       TaskResult?

  createdById String
  createdBy   User   @relation("CreatedTasks", fields: [createdById], references: [id], onDelete: Cascade)

  assignedToId String?
  assignedTo   User?   @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assignedToId])
  @@index([status])
  @@index([businessTypeId])
}

model Lead {
  id           String     @id @default(uuid())
  name         String
  email        String
  phone        String
  source       String?
  service      String?
  status       LeadStatus @default(NEW)
  notes        String?    @db.Text
  budget       String?
  assignedToId String?
  assignedTo   User?      @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([assignedToId])
  @@index([status])
}
